&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME GauXC_XC_energy_density
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS FALSE
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &PRINT
      &LOCAL_ENERGY_CUBE
      &END LOCAL_ENERGY_CUBE
      &XC_ENERGY_DENSITY
        &CUBE
          STRIDE 2 2 2
        &END CUBE
        &OPENPMD
          BASENAME "xc_energy_density"
          STRIDE 1 1 1
        &END OPENPMD
      &END XC_ENERGY_DENSITY
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION USE_PREV_WF
    &END QS
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 80
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          FUNCTIONAL PBE
          PERIODIC_REFERENCE T
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
      PERIODIC XYZ
    &END CELL
    &COORD
      N 3.000000 3.000000 3.000000
      H 3.000000 3.937700 2.618000
      H 2.187900 2.531150 2.618000
      H 3.812100 2.531150 2.618000
    &END COORD
    &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND N
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
