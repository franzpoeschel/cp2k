&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME BENZENE_SKALA_XC_ENERGY_DENSITY
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME GTH_BASIS_SETS
    MULTIPLICITY 1
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS FALSE
    &MGRID
      CUTOFF 250
      REL_CUTOFF 50
    &END MGRID
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &PRINT
      &XC_ENERGY_DENSITY_OPENPMD
        BASENAME "xc_energy_density"
        STRIDE 1 1 1
      &END XC_ENERGY_DENSITY_OPENPMD
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-8
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.0E-4
      IGNORE_CONVERGENCE_FAILURE T
      MAX_SCF 120
      SCF_GUESS ATOMIC
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_ATOM_PARTITION HARD
          NATIVE_GRID_DIAGNOSTICS T
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 16.0 16.0 10.0
      PERIODIC XYZ
    &END CELL
    &COORD
      C  2.281977 -1.317500  0.000000
      C  2.281977  1.317500  0.000000
      C  0.000000  2.635000  0.000000
      C -2.281977  1.317500  0.000000
      C -2.281977 -1.317500  0.000000
      C  0.000000 -2.635000  0.000000
      H  4.683000  0.000000  0.000000
      H  2.341500  4.055597  0.000000
      H -2.341500  4.055597  0.000000
      H -4.683000  0.000000  0.000000
      H -2.341500 -4.055597  0.000000
      H  2.341500 -4.055597  0.000000
    &END COORD
    &KIND C
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND H
      BASIS_SET DZVP-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
